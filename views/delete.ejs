<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Delete</title>
</head>
<body>
    <h1>Choose the post you want deleted!</h1>
    <form id="deleteForm" data-post-id="<%= postID %>">
        <div>
            <label for="new_delete">Delete your post here</label>
            <input type="text" id="new_delete" name="delete">
            <button type="submit">Delete</button>
        </div>

    </form>
    <script>
        document.getElementById('deleteForm').addEventListener('submit', async (event) => {
          event.preventDefault();
      
          const form = document.getElementById('deleteForm');
          const postId = form.dataset.postId;
      
          const data = {
            description: document.getElementById('new_delete').value
          };
      
          const res = await fetch(`/submit/${postId}`, {
            method: 'DELETE',
            headers: {'Content-Type': 'application/json'},
            body: JSON.stringify(data)
          });

          if(res.ok){
            window.location.href = "/"
          }else{
            console.log("delete failed")
          }

          
      
          const result = await res.json();
          console.log(result);

      
      
        });
      </script>
</body>
</html>