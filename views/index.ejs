<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>PetsChef</title>
    <link rel="stylesheet" href="/main.css">
</head>
<body>
 <h1>Testing Testing</h1>  


 <h2>Write a post:</h2>


    <form method="POST" action="/submit" enctype="multipart/form-data">
        <div>
            <label for="file">Upload a picture of your pets meal</label>
            <input type="file" id="file" name="file" accept="image/png, image/jpg">
        </div>

        <div>
            <label for="description">Write a description for your pets meal :D</label>
            <input type="text" id="description" name="description">
        </div>

        <div>
            <button type="submit">Post</button>
        </div>
    </form>

   

    <% if (locals.uploads) { %>
        <% uploads.forEach(function(upload){%>
            
            <img src="<%= upload.postImage %>">

            <h3><%= upload.postMessage%></h3>

            <div>
           <a href="/edit?id=<%=upload.postID%>">Edit</a>

           

            </div>

        <%} )%>
      
    
    <%}%>

   


  

 
</body>
</html>