<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>PetsChef</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
    <link rel="stylesheet" href="/main.css">
</head>
<body>
    <%- include('partials/header') %>
    <main class="container">
 

<h2 class="fw-semibold mt-4 mb-3">Write a post:</h2>


    <form method="POST" action="/submit" enctype="multipart/form-data">
        <div class="mb-3">
            <label for="file" class="form-label fw-semibold">Upload a picture of your pets meal</label>
            <input class="form-control form-control-lg" type="file" id="file" name="file" accept="image/png, image/jpg" required>
        </div>

        <div class="mb-3">
            <label for="description" class="form-label fw-semibold">Write a description for your pets meal :D</label>
  
            <textarea class="form-control fs-5" name ="description" id="description" rows="3" required></textarea>
        </div>

        <div class="mt-2">
            <button  class="btn btn-dark"  type="submit">Post</button>
        </div>
    </form>

    <% if (locals.uploads) { %>
        <div class="row g-4 mt-2">
          <% uploads.forEach(function(upload){ %>
            <div class="col-12 col-md-4">
              <div class="card h-100">
                <img src="<%= upload.postImage %>" class="card-img-top" alt="image of pet food" style="height: 220px; object-fit: cover;">
                <div class="card-body d-flex flex-column">
                  <p class="card-text"><%= upload.postMessage %></p>
                  <div class="mt-auto">
                    <a class="btn btn-dark" href="/edit?id=<%= upload.postID %>">Edit</a>
                    <button class="btn btn-secondary" onclick="deletePost('<%= upload.postID %>')">Delete</button>
                  </div>
                </div>
              </div>
            </div>
          <% }) %>
        </div>
        <% } %>

   </main>

    <%- include('partials/footer') %>

   


<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>
<script>
    async function deletePost(postID){
        const res = await fetch(`/submit/${postID}`,{
            method: 'DELETE'
        });

        if(res.ok){
            //window.location.reload() //incorrect! reloading current which was /submit! /submit IS FOR POSTING LMAO NOT GETTING
            window.location.reload()
        }else{
            alert("Failed to delete post")
        }
    }
</script>
 
</body>
</html>